// hk configuration - https://hk.jdx.dev/
amends "package://github.com/jdx/hk/releases/download/v1.50.0/hk@1.50.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.50.0/hk@1.50.0#/Builtins.pkl"

exclude =
  List(
    "node_modules",
    "dist",
    "coverage",
    "report",
    ".git",
    ".repos",
    ".stryker-tmp",
    "do-not-sync-ever",
    ".lune/Packages",
  )
display_skip_reasons = List()
terminal_progress = false

local binary_excludes =
  List(
    "*.png",
    "*.jpg",
    "*.jpeg",
    "*.gif",
    "*.webp",
    "*.ico",
    "*.woff",
    "*.woff2",
    "*.ttf",
    "*.eot",
    "*.pdf",
    "*.zip",
    "*.tar",
    "*.gz",
    "*.mp4",
    "*.mov",
  )

local workflow_files =
  List(
    ".github/workflows/**/*.yml",
    ".github/workflows/**/*.yaml",
  )
local workflow_action_files =
  List(
    ".github/workflows/**/*.yml",
    ".github/workflows/**/*.yaml",
    ".github/actions/**/action.yml",
    ".github/actions/**/action.yaml",
  )
local zizmor_files =
  List(
    ".github/workflows/**/*.yml",
    ".github/workflows/**/*.yaml",
    ".github/actions/**/action.yml",
    ".github/actions/**/action.yaml",
    ".github/dependabot.yml",
  )
local markdown_files = List("**/*.md", "**/*.markdown", "**/*.mdx")
local toml_files = List("**/*.toml")
local luau_files = List("*.lua", "*.luau", "**/*.lua", "**/*.luau")
local js_ts_files =
  List(
    "*.js",
    "*.jsx",
    "*.ts",
    "*.tsx",
    "*.mjs",
    "*.cjs",
    "*.mts",
    "*.cts",
    "*.astro",
    "*.mdx",
  )

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      // Tier 1 — Universal checks
      ["trailing-whitespace"] = (Builtins.trailing_whitespace) {
        exclude = binary_excludes
      }
      ["newlines"] = (Builtins.newlines) {
        exclude = binary_excludes
      }
      ["check-merge-conflict"] = (Builtins.check_merge_conflict) {}
      ["check-case-conflict"] = (Builtins.check_case_conflict) {}
      ["check-symlinks"] = (Builtins.check_symlinks) {}
      ["mixed-line-ending"] = (Builtins.mixed_line_ending) {}
      ["detect-private-key"] = (Builtins.detect_private_key) {
        exclude = binary_excludes
      }
      ["betterleaks"] = Builtins.betterleaks
      ["sherif"] {
        glob = List("**/package.json", "**/pnpm-workspace.yaml")
        check = "node --run sherif -- -r root-package-private-field -r root-package-dependencies"
        fix =
          "node --run sherif -- --fix --no-install -r root-package-private-field -r root-package-dependencies"
      }

      // Luau linter — selene
      ["selene"] {
        glob = luau_files
        check = "selene {{files}}"
        check_first = true
        batch = true
      }

      // JS/TS pipeline — oxlint + biome + oxfmt
      ["oxlint"] = (Builtins.ox_lint) {
        glob = js_ts_files
        check = "node --run oxlint -- --no-error-on-unmatched-pattern {{files}}"
        fix = "node --run oxlint -- --no-error-on-unmatched-pattern --fix {{files}}"
        check_first = true
        batch = false
      }
      ["biome-js"] = (Builtins.biome) {
        glob = js_ts_files
        check = "node --run biome -- check --no-errors-on-unmatched {{files}}"
        fix = "node --run biome -- check --write --no-errors-on-unmatched {{files}}"
        check_first = true
        batch = false
      }
      ["oxfmt-js"] = (Builtins.oxfmt) {
        glob = List("*.ts", "*.tsx", "*.mts", "*.cts")
        check = "node --run oxfmt -- --no-error-on-unmatched-pattern --check {{files}}"
        fix = "node --run oxfmt -- --no-error-on-unmatched-pattern {{files}}"
        check_first = true
      }

      // Biome non-JS — css, html, grit
      ["biome-non-js"] = (Builtins.biome) {
        glob = List("*.css", "*.html", "*.grit")
        check = "node --run biome -- check --no-errors-on-unmatched {{files}}"
        fix = "node --run biome -- check --write --no-errors-on-unmatched {{files}}"
        check_first = true
        batch = false
      }

      // oxfmt for json, jsonc, json5, code-workspace, and mdx
      ["oxfmt-json-mdx"] = (Builtins.oxfmt) {
        glob = List("*.json", "*.jsonc", "*.json5", "*.code-workspace", "*.mdx")
        exclude = List("skills-lock.json")
        check = "node --run oxfmt -- --no-error-on-unmatched-pattern --check {{files}}"
        fix = "node --run oxfmt -- --no-error-on-unmatched-pattern {{files}}"
        check_first = true
      }

      // Pkl — hk and other typed config files
      ["pkl-format"] = (Builtins.pkl_format) {
        glob = List("*.pkl")
        check_first = true
      }

      // Shell scripts
      ["shfmt"] {
        glob = List("**/*.sh", "**/*.bash", "**/*.ksh")
        check = "shfmt -bn -ci -sr -d {{files}}"
        fix = "shfmt -bn -ci -sr -w {{files}}"
        check_first = true
      }
      ["shfmt-detected-shell"] {
        types = List("shell")
        exclude = List("**/*.sh", "**/*.bash", "**/*.ksh")
        check = "shfmt -bn -ci -sr -d {{files}}"
        fix = "shfmt -bn -ci -sr -w {{files}}"
        check_first = true
      }
      ["shellcheck"] = (Builtins.shellcheck) {
        glob = List("**/*.sh", "**/*.bash", "**/*.ksh", "**/*.dash", "**/*.zsh")
      }
      ["shellcheck-detected-shell"] {
        types = List("shell")
        exclude = List("**/*.sh", "**/*.bash", "**/*.ksh", "**/*.dash", "**/*.zsh")
        check = "shellcheck {{files}}"
        batch = true
      }

      // GitHub Actions workflows
      ["actionlint"] = (Builtins.actionlint) {
        glob = workflow_files
      }
      ["zizmor"] = (Builtins.zizmor) {
        glob = zizmor_files
        prefix = "GH_TOKEN=\"$(gh auth token)\""
      }
      ["pinact"] {
        glob = workflow_action_files
        check = "PINACT_GITHUB_TOKEN=\"$(gh auth token)\" pinact run --verify {{files}}"
        fix = "PINACT_GITHUB_TOKEN=\"$(gh auth token)\" pinact run {{files}}"
        check_first = true
      }

      // Markdown — vale + harper + rumdl
      ["vale"] = Builtins.vale
      ["harper"] {
        glob = markdown_files
        exclude = List(".agents/skills/**/SKILL.md")
        check = "mise run harper-lint {{files}}"
        check_first = true
        batch = true
      }
      ["rumdl"] = (Builtins.rumdl) {
        glob = markdown_files
        exclude = List(".agents/skills/**/SKILL.md")
        check = "rumdl check {{files}}"
        fix =
          """
          rumdl check --fix {{files}}
          rumdl fmt {{files}}
          """
        check_first = true
        batch = true
      }

      // TOML — tombi lint + format
      ["tombi"] = (Builtins.tombi) {
        glob = toml_files
        check = "tombi lint {{files}} && tombi format --check {{files}}"
        fix =
          """
          tombi lint {{files}}
          tombi format {{files}}
          """
        check_first = true
        batch = true
      }
    }
  }

  ["commit-msg"] {
    steps {
      ["commitlint"] {
        check =
          "node --run commitlint -- --strict --config commitlint.config.ts --edit {{commit_msg_file}}"
      }
    }
  }

  ["pre-push"] {
    steps {
      ["ci"] {
        check = "mise run ci"
      }
    }
  }

  // Manual check/fix hooks for CI or local use
  ["check"] {
    steps {
      ["trailing-whitespace"] = (Builtins.trailing_whitespace) {
        exclude = binary_excludes
      }
      ["newlines"] = (Builtins.newlines) {
        exclude = binary_excludes
      }
      ["check-merge-conflict"] = (Builtins.check_merge_conflict) {}
      ["check-case-conflict"] = (Builtins.check_case_conflict) {}
      ["check-symlinks"] = (Builtins.check_symlinks) {}
      ["mixed-line-ending"] = (Builtins.mixed_line_ending) {}
      ["detect-private-key"] = (Builtins.detect_private_key) {
        exclude = binary_excludes
      }
      ["betterleaks"] = Builtins.betterleaks
      ["sherif"] {
        glob = List("**/package.json", "**/pnpm-workspace.yaml")
        check = "node --run sherif -- -r root-package-private-field -r root-package-dependencies"
      }
      ["selene"] {
        glob = luau_files
        check = "selene {{files}}"
        batch = true
      }
      ["oxlint"] = (Builtins.ox_lint) {
        glob = js_ts_files
        check = "node --run oxlint -- --no-error-on-unmatched-pattern {{files}}"
        batch = true
      }
      ["biome-js"] = (Builtins.biome) {
        glob = js_ts_files
        check = "node --run biome -- lint --no-errors-on-unmatched {{files}}"
        batch = true
      }
      ["biome-non-js"] = (Builtins.biome) {
        glob = List("*.css", "*.html", "*.grit")
        check = "node --run biome -- check --no-errors-on-unmatched {{files}}"
        batch = true
      }
      ["oxfmt"] = (Builtins.oxfmt) {
        glob =
          List(
            "*.js",
            "*.jsx",
            "*.ts",
            "*.tsx",
            "*.mjs",
            "*.cjs",
            "*.mts",
            "*.cts",
            "*.json",
            "*.jsonc",
            "*.json5",
            "*.code-workspace",
            "*.mdx",
          )
        check = "node --run oxfmt -- --no-error-on-unmatched-pattern --check {{files}}"
      }
      ["pkl-format"] = (Builtins.pkl_format) {
        glob = List("*.pkl")
      }
      ["shfmt"] {
        glob = List("**/*.sh", "**/*.bash", "**/*.ksh")
        check = "shfmt -bn -ci -sr -d {{files}}"
      }
      ["shfmt-detected-shell"] {
        types = List("shell")
        exclude = List("**/*.sh", "**/*.bash", "**/*.ksh")
        check = "shfmt -bn -ci -sr -d {{files}}"
      }
      ["shellcheck"] = (Builtins.shellcheck) {
        glob = List("**/*.sh", "**/*.bash", "**/*.ksh", "**/*.dash", "**/*.zsh")
      }
      ["shellcheck-detected-shell"] {
        types = List("shell")
        exclude = List("**/*.sh", "**/*.bash", "**/*.ksh", "**/*.dash", "**/*.zsh")
        check = "shellcheck {{files}}"
        batch = true
      }
      ["actionlint"] = (Builtins.actionlint) {
        glob = workflow_files
      }
      ["zizmor"] = (Builtins.zizmor) {
        glob = zizmor_files
        prefix = "GH_TOKEN=\"$(gh auth token)\""
      }
      ["pinact"] {
        glob = workflow_action_files
        check = "PINACT_GITHUB_TOKEN=\"$(gh auth token)\" pinact run --verify {{files}}"
      }
      ["vale"] = Builtins.vale
      ["harper"] {
        glob = markdown_files
        exclude = List(".agents/skills/**/SKILL.md")
        check = "mise run harper-lint {{files}}"
      }
      ["rumdl"] = (Builtins.rumdl) {
        glob = markdown_files
        exclude = List(".agents/skills/**/SKILL.md")
        check = "rumdl check {{files}}"
      }
      ["tombi"] = (Builtins.tombi) {
        glob = toml_files
        check = "tombi lint {{files}} && tombi format --check {{files}}"
      }
    }
  }

  ["fix"] {
    fix = true
    stash = "git"
    steps {
      ["trailing-whitespace"] = (Builtins.trailing_whitespace) {
        exclude = binary_excludes
      }
      ["newlines"] = (Builtins.newlines) {
        exclude = binary_excludes
      }
      ["check-case-conflict"] = (Builtins.check_case_conflict) {}
      ["check-symlinks"] = (Builtins.check_symlinks) {}
      ["mixed-line-ending"] = (Builtins.mixed_line_ending) {}
      ["detect-private-key"] = (Builtins.detect_private_key) {
        exclude = binary_excludes
      }
      ["betterleaks"] = Builtins.betterleaks
      ["sherif"] {
        glob = List("**/package.json", "**/pnpm-workspace.yaml")
        check = "node --run sherif -- -r root-package-private-field -r root-package-dependencies"
        fix =
          "node --run sherif -- --fix --no-install -r root-package-private-field -r root-package-dependencies"
      }
      ["selene"] {
        glob = luau_files
        check = "selene {{files}}"
        batch = true
      }
      ["oxlint"] = (Builtins.ox_lint) {
        glob = js_ts_files
        check = "node --run oxlint -- --no-error-on-unmatched-pattern {{files}}"
        fix = "node --run oxlint -- --no-error-on-unmatched-pattern --fix {{files}}"
        batch = true
      }
      ["biome-js"] = (Builtins.biome) {
        glob = js_ts_files
        check = "node --run biome -- lint --no-errors-on-unmatched {{files}}"
        fix = "node --run biome -- lint --write --no-errors-on-unmatched {{files}}"
        batch = true
      }
      ["biome-non-js"] = (Builtins.biome) {
        glob = List("*.css", "*.html", "*.grit")
        check = "node --run biome -- check --no-errors-on-unmatched {{files}}"
        fix = "node --run biome -- check --write --no-errors-on-unmatched {{files}}"
        batch = true
      }
      ["oxfmt"] = (Builtins.oxfmt) {
        glob =
          List(
            "*.js",
            "*.jsx",
            "*.ts",
            "*.tsx",
            "*.mjs",
            "*.cjs",
            "*.mts",
            "*.cts",
            "*.json",
            "*.jsonc",
            "*.json5",
            "*.code-workspace",
            "*.mdx",
          )
        check = "node --run oxfmt -- --no-error-on-unmatched-pattern --check {{files}}"
        fix = "node --run oxfmt -- --no-error-on-unmatched-pattern {{files}}"
      }
      ["pkl-format"] = (Builtins.pkl_format) {
        glob = List("*.pkl")
      }
      ["shfmt"] {
        glob = List("**/*.sh", "**/*.bash", "**/*.ksh")
        fix = "shfmt -bn -ci -sr -w {{files}}"
      }
      ["shfmt-detected-shell"] {
        types = List("shell")
        exclude = List("**/*.sh", "**/*.bash", "**/*.ksh")
        fix = "shfmt -bn -ci -sr -w {{files}}"
      }
      ["shellcheck"] = (Builtins.shellcheck) {
        glob = List("**/*.sh", "**/*.bash", "**/*.ksh", "**/*.dash", "**/*.zsh")
      }
      ["shellcheck-detected-shell"] {
        types = List("shell")
        exclude = List("**/*.sh", "**/*.bash", "**/*.ksh", "**/*.dash", "**/*.zsh")
        check = "shellcheck {{files}}"
        batch = true
      }
      ["actionlint"] = (Builtins.actionlint) {
        glob = workflow_files
      }
      ["zizmor"] = (Builtins.zizmor) {
        glob = zizmor_files
        check_diff = "GH_TOKEN=\"$(gh auth token)\" zizmor --no-progress {{files}}"
        fix = "GH_TOKEN=\"$(gh auth token)\" zizmor --no-progress --fix {{files}}"
      }
      ["pinact"] {
        glob = workflow_action_files
        fix = "PINACT_GITHUB_TOKEN=\"$(gh auth token)\" pinact run {{files}}"
      }
      ["vale"] = Builtins.vale
      ["harper"] {
        glob = markdown_files
        exclude = List(".agents/skills/**/SKILL.md")
        check =
          "harper-cli lint --format compact --only SpellCheck --user-dict-path .harper-dictionary.txt {{files}}"
      }
      ["rumdl"] = (Builtins.rumdl) {
        glob = markdown_files
        exclude = List(".agents/skills/**/SKILL.md")
        fix =
          """
          rumdl check --fix {{files}}
          rumdl fmt {{files}}
          """
      }
      ["tombi"] = (Builtins.tombi) {
        glob = toml_files
        fix =
          """
          tombi lint {{files}}
          tombi format {{files}}
          """
      }
    }
  }
}
