{
	"name": "janitor",
	"version": "1.18.3",
	"private": true,
	"description": "The Janitor cleanup library",
	"author": {
		"name": "HowManySmall"
	},
	"type": "module",
	"scripts": {
		"biome": "biome",
		"changelogithub": "changelogithub",
		"commitlint": "commitlint",
		"lint": "bash -c 'a=$(bash scripts/get-defaults.sh \"$@\"); node --run oxlint -- --no-error-on-unmatched-pattern $a && node --run biome -- check --no-errors-on-unmatched $a' _",
		"oxfmt": "oxfmt",
		"oxlint": "oxlint",
		"release": "bumpp",
		"sherif": "sherif",
		"tsgo": "tsgo",
		"type-check": "node --run tsgo -- --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:dev",
		"@commitlint/cli": "catalog:dev",
		"@commitlint/config-conventional": "catalog:dev",
		"@commitlint/types": "catalog:dev",
		"@pobammer-ts/small-rules": "catalog:dev",
		"@total-typescript/ts-reset": "catalog:dev",
		"@types/node": "catalog:dev",
		"@typescript/native-preview": "catalog:dev",
		"bumpp": "catalog:dev",
		"eslint-plugin-antfu": "catalog:dev",
		"eslint-plugin-regexp": "catalog:dev",
		"eslint-plugin-sonarjs": "catalog:dev",
		"eslint-plugin-unused-imports": "catalog:dev",
		"moonwave": "catalog:dev",
		"oxfmt": "catalog:dev",
		"oxlint": "catalog:dev",
		"oxlint-plugin-react-doctor": "catalog:dev",
		"oxlint-tsgolint": "catalog:dev",
		"pncat": "catalog:dev",
		"sherif": "catalog:dev",
		"typescript": "catalog:dev"
	},
	"packageManager": "pnpm@11.17.0"
}
